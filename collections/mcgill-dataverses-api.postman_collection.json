  "info": {
    "_postman_id": "216aa283-1900-42c8-8725-d042b5b62287",
    "name": "McGill University Dataverse (Borealis) - Native Dataverses API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Dataverse Native REST API serving the McGill University Dataverse research-data repository on the Borealis (Scholars Portal) platform. Provides programmatic access to the McGill collection, its contents, and installation info. Faithful subset of the upstream Dataverse OpenAPI (Dataverse v6.8.1-SP); response schemas derived from verified live responses. Write/admin operations require an X-Dataverse-key API token.\n\nContact Support:\n Name: McGill Research Data Management\n Email: rdm.library@mcgill.ca",
      "type": "text/plain"
    }
  }
